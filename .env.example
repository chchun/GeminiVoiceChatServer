# [App Configuration]
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# [Client Authentication]
# Android 클라이언트가 ws 연결 시 ?api_key=<KEY> 쿼리로 전달하는 인증 키.
# 동일한 값을 Android BuildConfig.SERVER_URL 에도 박아둘 것.
WS_API_KEY=dev-local-key-change-me

# [AI Client Configuration]
GEMINI_API_KEY=AIzaSyYourActualGeminiApiKeyHere_xxxxxxxx
# 음성 대화의 낮은 지연이 중요해 lite 권장.
# 품질 우선 시 gemini-2.5-flash, 자동 최신 시 gemini-flash-latest.
GEMINI_MODEL=gemini-2.5-flash-lite
